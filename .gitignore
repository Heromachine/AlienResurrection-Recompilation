bin/
obj/

# Everything generated/downloaded at runtime. This is the entire reason this repo exists in this
# shape: no game-derived code is ever committed. game/Recompiled/*.cs is regenerated from each
# user's own disc on first run; nothing under game/ should ever be tracked.
game/
settings.json
interface.ini
*.sav
*.sav.bak*

# User-supplied display font. "Alien Resurrection.ttf" by Jens R. Ziehn is Free for Personal Use
# and carries no redistribution grant, so it must never be committed -- the launcher looks for a
# copy the user supplies themselves and falls back to the default face without one.
*.ttf
*.otf
