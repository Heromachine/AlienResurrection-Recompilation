<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AlienResurrectionLauncher</AssemblyName>
    <!-- SemVer, pre-1.0: nothing here is stable yet (see README's known-issues list). Bump MINOR
         for each update; move to 1.0.0 once that list is empty. -->
    <Version>0.2.0</Version>
    <!-- Without this, MSBuild appends "+<git-sha>" to AssemblyInformationalVersion, which is where
         the window title and About panel read the version from: fine for provenance, but it turns
         the title bar into "...v0.1.0+d4e67fa5374..." instead of "...v0.1.0". -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- RELATIVE, not absolute. The engine fork is a separate repository; this expects it checked out
       as a SIBLING directory (../RecompOne-fork). An absolute path worked on the machine it was
       written on and nowhere else, so anyone cloning this repo could not build it at all. Override
       with the RecompOneDir property if your checkout lives elsewhere. Swap for a package or
       submodule reference once the fork has a public URL. -->
  <PropertyGroup>
    <RecompOneDir Condition="'$(RecompOneDir)' == ''">$(MSBuildThisFileDirectory)../RecompOne-fork</RecompOneDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(RecompOneDir)/RecompOne.Runtime/RecompOne.Runtime.csproj" />
    <ProjectReference Include="$(RecompOneDir)/RecompOne.Recompiler/RecompOne.Recompiler.csproj" />
  </ItemGroup>

  <!-- Roslyn comes in transitively via RecompOne.Runtime (it already uses
       Microsoft.CodeAnalysis.CSharp for the mod system), so no separate package reference is
       needed here. The in-process build step reuses that same dependency. -->

  <!-- GameTemplate/*.cs are template ASSETS materialized into game/ at runtime, not launcher code.
       Exclude them from the SDK's default **/*.cs compile glob, which would otherwise try to
       build GameTemplate/Program.cs's own top-level statements into this project too. -->
  <ItemGroup>
    <Compile Remove="GameTemplate/**/*.cs" />
    <None Include="assets/**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="GameTemplate/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- publish/ (publish_release.py's output, including its AppDir staging copy of this project's
       own output) is a subdirectory of the project root and would otherwise be picked up by the
       SDK's default **/*.cs compile glob on the NEXT publish run. A stale copy of
       GameTemplate/Program.cs sitting under publish/AppDir/usr/bin/GameTemplate/ from a prior
       AppImage build collided with this project's own top-level statements (CS8802). bin/ and
       obj/ are excluded by the SDK by default; publish/ is not. -->
  <ItemGroup>
    <Compile Remove="publish/**/*.cs" />
  </ItemGroup>

</Project>
